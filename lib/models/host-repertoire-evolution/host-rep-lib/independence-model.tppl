import "container-types.tppl"

function independenceLikelihood(
  fromRep: Int[],
  toRep: Int[],
  fromAge: Real,
  toAge: Real,
  eventSeqs: Event[][],
  modelParams: ModelParams
) => Real {
  val unconditional = fold(
    function(acc: Real, h: Int) => Real {
      val eventSeq = eventSeqs[h];
      val fromState = fromRep[h];
      val toState = toRep[h];
      return acc + hostIndepLikelihood(
        1,
        fromState,
        toState,
        fromAge,
        toAge,
        eventSeq,
        modelParams.embeddedQMatrix
      );
    },
    0.0,
    1 to (length(eventSeqs))
  );
  return unconditional;
}

function independenceLikelihoodEndCond(
  fromRep: Int[],
  toRep: Int[],
  fromAge: Real,
  toAge: Real,
  eventSeqs: Event[][],
  modelParams: ModelParams,
  kernel: Matrix[Real]
) => Real {
  // If the CTMC samle is x(.) then the below computes 
  //      P[X(.) = x(.), X(T) = b | X(0) = a]
  val unconditional = independenceLikelihood(
   fromRep,
    toRep,
    fromAge,
    toAge,
    eventSeqs,
    modelParams
  );
  // For correct weights we need to compute P[X(T) = b | X(0) = a]
  val logTotalTransProb = fold(
    function(acc: Real, x: Real) => Real { return acc + x; },
    0.0,
    zipWith(
      function(fromState: Int, toState: Int) => Real {
        return log(mtxGet(fromState + 1, toState + 1, kernel));
      },
      fromRep,
      toRep
    )
  );
  // The weight of the branch sample is P[X(.) = x(.) | X(0) = a, X(T) = b]
  val conditional = unconditional - logTotalTransProb;
  return conditional;
}

function hostIndepLikelihood(
  nextIndex: Int,
  currState: Int,
  finalState: Int,
  currAge: Real,
  finalAge: Real,
  eventSeq: Event[],
  embeddedQMatrix: EmbeddedMarkovChainMatrix
) => Real {
  if nextIndex > length(eventSeq) {
    val timePassed = currAge - finalAge;
    val outRate = embeddedQMatrix.totalRates[currState + 1];
    return -timePassed * outRate;
  } else {
    val nextEvent = eventSeq[nextIndex];
    val nextState = nextEvent.toState;
    val nextAge = nextEvent.eventTime;
    val timePassed = currAge - nextAge;
    val outRate = embeddedQMatrix.totalRates[currState + 1];
    val transProb = embeddedQMatrix.transitionProbs[currState + 1][nextState + 1];
    return log(transProb) - timePassed * outRate + hostIndepLikelihood(
      nextIndex + 1,
      nextState,
      finalState,
      nextAge,
      finalAge,
      eventSeq,
      embeddedQMatrix
    );
  }
}
